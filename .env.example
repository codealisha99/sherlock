# Sherlock LLM Gateway configuration
# Copy to .env and fill in values. Never commit real credentials.

# Provider selection: "groq" or "ollama" (default: ollama)
LLM_PROVIDER=ollama

# GroqCloud settings (only used when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45

# Strict free-tier budget protection (UTC-based daily windows)
LLM_DAILY_REQUEST_BUDGET=100
LLM_DAILY_TOKEN_BUDGET=50000
LLM_PER_MINUTE_REQUEST_LIMIT=20
LLM_PER_MINUTE_TOKEN_LIMIT=10000
LLM_MAX_CONCURRENT_REQUESTS=2
LLM_MAX_OUTPUT_TOKENS=1500

# Ollama settings (local fallback)
SHERLOCK_OLLAMA_HOST=http://localhost:11434
SHERLOCK_MODEL=qwen3-coder:30b
SHERLOCK_TIMEOUT=120

# Repository isolation for caching and request metadata
LLM_REPO_ISOLATION=true
